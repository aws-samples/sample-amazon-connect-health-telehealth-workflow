# Copy this file to `.env` and fill in values for a live deployment.
# NOT required for the local demo: `python server.py --demo` runs entirely from
# backend/demo_cache/ with no AWS credentials and no Connect Health enablement.

# --- AWS ---
AWS_PROFILE=
AWS_REGION=us-east-1

# --- Amazon Connect Health (requires enablement via your AWS account team) ---
SERVICE_NAME=connecthealth
SERVICE_ENDPOINT=https://health-agent.us-east-1.api.aws
DOMAIN_ID=                     # e.g., dom-abc123def456

# --- HealthLake (bring your own datastore, loaded with synthetic FHIR data) ---
HEALTHLAKE_DATASTORE_ID=
HEALTHLAKE_DATASTORE_NAME=

# --- S3 output ---
S3_OUTPUT_BUCKET=              # e.g., s3://my-bucket/insights-output/
STREAMING_OUTPUT_BUCKET=       # e.g., my-bucket (no s3:// prefix)
STREAMING_OUTPUT_REGION=us-east-1

# --- SMS notifications (optional) ---
SMS_AWS_PROFILE=
SMS_REGION=us-east-1
SMS_ORIGINATION_NUMBER=        # e.g., +18005551234

# --- Bedrock (narrative synthesis + custom triage agent) ---
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=2048

# --- Optional live-cache overrides (leave blank; local demo uses backend/demo_cache/) ---
DEMO_CACHE_PATIENT_A=
DEMO_CACHE_PATIENT_B=
DEMO_CACHE_PATIENT_C=

# --- Server ---
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
DEBUG=false
CORS_ORIGINS=

# --- Optional default patient ---
DEFAULT_PATIENT_ID=
